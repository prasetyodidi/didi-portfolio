---
import Layout from '../../layouts/Layout.astro';
import { getProjectBySlug } from '../../data/projects.js';
import FooterSection from '../../components/FooterSection.jsx';
import ProjectLinks from '../../components/ProjectLinks.jsx';

const { slug } = Astro.params;
const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.label} - Project Detail`}>
    <main class="min-h-screen bg-slate-50 flex flex-col">
      <header class="sticky top-0 z-50 flex items-center px-6 md:px-12 py-4 bg-white/80 backdrop-blur-md border-b border-gray-100">
        <a id="dynamic-back-btn" href="/" class="font-bold text-xl text-black flex items-center gap-2 hover:text-orange-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span id="dynamic-back-text">Back to Home</span>
        </a>
      </header>

      <article class="flex-grow">
        <div class="max-w-4xl mx-auto w-full px-6 py-12 md:py-20">
          <div class="mb-10 text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">{project.label}</h1>
            <div class="flex flex-wrap justify-center gap-2 mb-6">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 bg-primaryOrange/10 text-orange-700 rounded-full text-sm font-semibold">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class="flex flex-col md:flex-row items-center justify-center gap-4 mb-8 text-slate-600 font-medium">
              {project.role && (
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  <span>{project.role}</span>
                </div>
              )}
              {project.role && project.duration && <span class="hidden md:inline text-slate-300">•</span>}
              {project.duration && (
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  <span>{project.duration}</span>
                </div>
              )}
            </div>

            <p class="text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto">
              {project.description}
            </p>
          </div>

          <div class="mb-16">
            <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center md:text-left">Project Gallery</h2>
            <div class={`grid grid-cols-1 gap-6 w-full ${project.platform === 'mobile' ? 'sm:grid-cols-2 md:grid-cols-3' : 'md:grid-cols-2'}`}>
              <div class={`relative w-full rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-slate-100 col-span-1 ${project.platform === 'mobile' ? 'h-[500px] sm:col-span-2 md:col-span-3' : 'h-[300px] md:h-[450px] md:col-span-2'}`}>
                {project.image && <img src={project.image} alt={`${project.label} Main`} class={`w-full h-full ${project.platform === 'mobile' ? 'object-contain py-4' : 'object-cover'}`} />}
              </div>
              
              {project.gallery && project.gallery.length > 0 && project.gallery.map((img, idx) => (
                <div class={`relative w-full rounded-3xl overflow-hidden shadow-md border-4 border-white bg-slate-100 flex items-center justify-center ${project.platform === 'mobile' ? 'h-[400px]' : 'h-[250px]'}`}>
                  <img src={img} alt={`${project.label} Gallery Image ${idx + 1}`} class={`w-full h-full hover:scale-105 transition-transform duration-500 ${project.platform === 'mobile' ? 'object-contain py-4' : 'object-cover'}`} />
                </div>
              ))}
            </div>
          </div>

          <div class="prose prose-lg prose-slate max-w-none text-slate-700">
            {project.achievements && project.achievements.length > 0 ? (
              <>
                <h2 class="text-2xl font-bold text-slate-800 mb-4">Impact & Achievements</h2>
                <ul class="list-disc pl-5 mb-12 space-y-2">
                  {project.achievements.map((item) => (
                    <li class="leading-relaxed">{item}</li>
                  ))}
                </ul>
              </>
            ) : (
              <>
                <h2 class="text-2xl font-bold text-slate-800 mb-4">Project Overview</h2>
                <p class="leading-relaxed mb-12">
                  {project.content}
                </p>
              </>
            )}
            
            {(project.community || (project.relatedCertificates && project.relatedCertificates.length > 0)) && (
              <>
                <h2 class="text-2xl font-bold text-slate-800 mb-4">Related Credentials & Community</h2>
                <ul class="list-disc pl-5 mb-12 space-y-2">
                  {project.community && <li class="leading-relaxed font-semibold">Organization: <span class="font-normal">{project.community}</span></li>}
                  {project.relatedCertificates && project.relatedCertificates.map((cert) => (
                    <li class="leading-relaxed font-semibold">Certification: <span class="font-normal">{cert}</span></li>
                  ))}
                </ul>
              </>
            )}
            
            <h2 class="text-2xl font-bold text-slate-800 mb-4">Links & Resources</h2>
            <ProjectLinks githubLink={project.githubLink} liveLink={project.liveLink} />
          </div>
        </div>
      </article>

      <FooterSection />
    </main>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const backBtn = document.getElementById('dynamic-back-btn');
        const backText = document.getElementById('dynamic-back-text');
        
        // Check if user came from the All Projects page
        if (document.referrer && document.referrer.includes('/projects')) {
          backBtn.href = '/projects';
          backText.textContent = 'Back to Projects';
        } else {
          backBtn.href = '/';
          backText.textContent = 'Back to Home';
        }
      });
    </script>
</Layout>
