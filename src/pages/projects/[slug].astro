---
import Layout from '../../layouts/Layout.astro';
import { getProjectBySlug } from '../../data/projects.js';
import FooterSection from '../../components/FooterSection.jsx';
import ProjectLinks from '../../components/ProjectLinks.jsx';

const { slug } = Astro.params;
const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.label} - Project Detail`}>
    <main class="min-h-screen bg-slate-50 flex flex-col">
      <header class="sticky top-0 z-50 flex items-center px-6 md:px-12 py-4 bg-white/80 backdrop-blur-md border-b border-gray-100">
        <a href="/" class="font-bold text-xl text-black flex items-center gap-2 hover:text-primaryOrange transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Home
        </a>
      </header>

      <article class="flex-grow">
        <div class="max-w-4xl mx-auto w-full px-6 py-12 md:py-20">
          <div class="mb-10 text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">{project.label}</h1>
            <div class="flex flex-wrap justify-center gap-2 mb-8">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 bg-primaryOrange/10 text-primaryOrange rounded-full text-sm font-semibold">
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto">
              {project.description}
            </p>
          </div>

          <div class="mb-16">
            <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center md:text-left">Project Gallery</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
              <div class="relative w-full h-[300px] md:h-[450px] rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-slate-100 col-span-1 md:col-span-2">
                {project.image && <img src={project.image} alt={`${project.label} Main`} class="object-cover w-full h-full" />}
              </div>
              
              {project.gallery && project.gallery.length > 0 && project.gallery.map((img, idx) => (
                <div class="relative w-full h-[250px] rounded-3xl overflow-hidden shadow-md border-4 border-white bg-slate-100">
                  <img src={img} alt={`${project.label} Gallery Image ${idx + 1}`} class="object-cover w-full h-full hover:scale-105 transition-transform duration-500" />
                </div>
              ))}
            </div>
          </div>

          <div class="prose prose-lg prose-slate max-w-none text-slate-700">
            <h2 class="text-2xl font-bold text-slate-800 mb-4">Project Overview</h2>
            <p class="leading-relaxed mb-12">
              {project.content}
            </p>
            
            <h2 class="text-2xl font-bold text-slate-800 mb-4">Links & Resources</h2>
            <ProjectLinks githubLink={project.githubLink} liveLink={project.liveLink} />
          </div>
        </div>
      </article>

      <FooterSection />
    </main>
</Layout>
