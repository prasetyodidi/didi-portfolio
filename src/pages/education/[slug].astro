---
import Layout from '../../layouts/Layout.astro';
import { getEducationBySlug, education } from '../../data/education.js';
import FooterSection from '../../components/FooterSection.jsx';

export function getStaticPaths() {
  return education.map((edu) => ({
    params: { slug: edu.slug },
  }));
}

const { slug } = Astro.params;
const edu = getEducationBySlug(slug);

if (!edu) {
  return Astro.redirect('/404');
}
---

<Layout title={`${edu.title} - Credential Detail`}>
    <main class="min-h-screen bg-slate-50 flex flex-col">
      <header class="sticky top-0 z-50 flex items-center px-6 md:px-12 py-4 bg-white/80 backdrop-blur-md border-b border-gray-100">
        <a id="dynamic-back-btn" href="/" class="font-bold text-xl text-black flex items-center gap-2 hover:text-orange-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span id="dynamic-back-text">Back to Home</span>
        </a>
      </header>

      <article class="flex-grow flex items-center justify-center py-12 px-6">
        <div class="max-w-3xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-100">
          <div class="h-64 sm:h-80 w-full bg-slate-100 flex flex-wrap items-center justify-center gap-8 p-8 relative overflow-hidden">
            <div class="absolute inset-0 opacity-40 bg-gradient-to-br from-orange-100 to-rose-100"></div>
            {edu.coverImages?.map((img) => (
              <img 
                src={img} 
                alt={edu.title} 
                class={`object-contain relative z-10 drop-shadow-xl transition-all ${edu.coverImages.length === 1 ? 'max-h-56 max-w-[80%]' : 'max-h-32 max-w-[40%]'}`} 
              />
            ))}
          </div>
          
          <div class="p-8 md:p-12">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-3 py-1 bg-orange-100 text-orange-700 rounded-full text-xs font-bold tracking-wider uppercase">
                {edu.category}
              </span>
              <span class="text-sm font-semibold text-slate-400">{edu.issuer}</span>
            </div>
            
            <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6 leading-tight">{edu.title}</h1>
            
            <div class="prose prose-lg text-slate-600 mb-10">
              <p>{edu.description}</p>
            </div>
            
            {edu.verificationUrl && edu.verificationUrl !== '#' && (
              <div class="border-t border-slate-100 pt-8">
                <a 
                  href={edu.verificationUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white font-bold rounded-xl hover:bg-orange-600 transition-colors shadow-md hover:shadow-xl w-full sm:w-auto"
                >
                  Verify Credential
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a>
              </div>
            )}
          </div>
        </div>
      </article>

      <FooterSection />
    </main>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const backBtn = document.getElementById('dynamic-back-btn');
        const backText = document.getElementById('dynamic-back-text');
        
        // Check if user came from the All Education page
        if (document.referrer && document.referrer.includes('/education')) {
          backBtn.href = '/education';
          backText.textContent = 'Back to Credentials';
        } else {
          backBtn.href = '/';
          backText.textContent = 'Back to Home';
        }
      });
    </script>
</Layout>
